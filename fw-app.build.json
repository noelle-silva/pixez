{
  "profiles": {
    "release": {
      "build": {
        "command": "node",
        "args": [
          "scripts/build-windows.mjs",
          "--profile",
          "release"
        ]
      },
      "stageDir": "dist-app/v5-windows",
      "files": [
        { "from": "build/windows/x64/runner/Release/pixez.exe", "to": "pixez.exe" },
        { "from": "build/windows/x64/runner/Release/flutter_windows.dll", "to": "flutter_windows.dll" },
        { "from": "build/windows/x64/runner/Release/data", "to": "data" },
        { "from": "build/windows/x64/runner/Release/dartjni.dll", "to": "dartjni.dll" },
        { "from": "build/windows/x64/runner/Release/dynamic_color_plugin.dll", "to": "dynamic_color_plugin.dll" },
        { "from": "build/windows/x64/runner/Release/file_selector_windows_plugin.dll", "to": "file_selector_windows_plugin.dll" },
        { "from": "build/windows/x64/runner/Release/flutter_acrylic_plugin.dll", "to": "flutter_acrylic_plugin.dll" },
        { "from": "build/windows/x64/runner/Release/permission_handler_windows_plugin.dll", "to": "permission_handler_windows_plugin.dll" },
        { "from": "build/windows/x64/runner/Release/rhttp.dll", "to": "rhttp.dll" },
        { "from": "build/windows/x64/runner/Release/screen_retriever_windows_plugin.dll", "to": "screen_retriever_windows_plugin.dll" },
        { "from": "build/windows/x64/runner/Release/share_plus_plugin.dll", "to": "share_plus_plugin.dll" },
        { "from": "build/windows/x64/runner/Release/sqlite3.dll", "to": "sqlite3.dll" },
        { "from": "build/windows/x64/runner/Release/url_launcher_windows_plugin.dll", "to": "url_launcher_windows_plugin.dll" },
        { "from": "build/windows/x64/runner/Release/window_manager_plugin.dll", "to": "window_manager_plugin.dll" },
        { "from": "assets/images/icon.png", "to": "assets/images/icon.png" }
      ]
    },
    "dev": {
      "build": {
        "command": "node",
        "args": [
          "scripts/build-windows.mjs",
          "--profile",
          "dev"
        ]
      },
      "stageDir": "dist-app/v5-windows-dev",
      "files": [
        { "from": "build/windows/x64/runner/Debug/pixez.exe", "to": "pixez.exe" },
        { "from": "build/windows/x64/runner/Debug/flutter_windows.dll", "to": "flutter_windows.dll" },
        { "from": "build/windows/x64/runner/Debug/data", "to": "data" },
        { "from": "build/windows/x64/runner/Debug/dartjni.dll", "to": "dartjni.dll" },
        { "from": "build/windows/x64/runner/Debug/dynamic_color_plugin.dll", "to": "dynamic_color_plugin.dll" },
        { "from": "build/windows/x64/runner/Debug/file_selector_windows_plugin.dll", "to": "file_selector_windows_plugin.dll" },
        { "from": "build/windows/x64/runner/Debug/flutter_acrylic_plugin.dll", "to": "flutter_acrylic_plugin.dll" },
        { "from": "build/windows/x64/runner/Debug/permission_handler_windows_plugin.dll", "to": "permission_handler_windows_plugin.dll" },
        { "from": "build/windows/x64/runner/Debug/rhttp.dll", "to": "rhttp.dll" },
        { "from": "build/windows/x64/runner/Debug/screen_retriever_windows_plugin.dll", "to": "screen_retriever_windows_plugin.dll" },
        { "from": "build/windows/x64/runner/Debug/share_plus_plugin.dll", "to": "share_plus_plugin.dll" },
        { "from": "build/windows/x64/runner/Debug/sqlite3.dll", "to": "sqlite3.dll" },
        { "from": "build/windows/x64/runner/Debug/url_launcher_windows_plugin.dll", "to": "url_launcher_windows_plugin.dll" },
        { "from": "build/windows/x64/runner/Debug/window_manager_plugin.dll", "to": "window_manager_plugin.dll" },
        { "from": "assets/images/icon.png", "to": "assets/images/icon.png" }
      ]
    }
  }
}
